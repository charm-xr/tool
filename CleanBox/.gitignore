# Root allowlist: local inventories, logs, previews and generated binaries stay private.
/*
!/.gitignore
!/.gitattributes
!/.github/
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/build.ps1
!/CleanBox.exe.config
!/使用说明.txt
!/src/
!/assets/
/assets/*
!/assets/cleanbox.ico
!/assets/cleanbox.png
!/tools/
/tools/*
!/tools/make_icon.py
!/tools/verify-discovery.ps1
!/tools/package.ps1
!/downloads/
/downloads/*
!/downloads/CleanBox-Windows-x64.zip
!/downloads/CleanBox-Windows-x64.zip.sha256

**/__pycache__/
**/*.pyc
**/*.user
**/*.suo
**/.vs/
**/bin/
**/obj/
